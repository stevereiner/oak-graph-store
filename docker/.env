# Settings of docker/compose.arcadedb.yaml and docker/compose.neo4j.yaml (and oak-base.yaml): versions, logins
# (development only) and host ports.
# The host ports, and the ports they avoid (other local stacks, Windows' reserved range): docs/port-mappings.md.

# ----- Sling with Oak (both stacks) -----

# the Sling Starter image, and the Oak version it ships (the store is built against it)
SLING_IMAGE=apache/sling:14
OAK_VERSION=1.90.0
# Composum Tools (JCR browser and editor, packages, users): a release tag of ist-dresden/composum-tools, built in the
# image
COMPOSUM_TOOLS_VERSION=1.4.1
# Sling host ports: http://localhost:<port> (login admin / admin, Sling's default administrator)
SLING_ARCADEDB_PORT=8180
SLING_NEO4J_PORT=8181

# ----- ArcadeDB (stack compose.arcadedb.yaml) -----

ARCADEDB_VERSION=26.10.1
# the server's admin user: must be root (the server only sets its password)
ARCADEDB_USERNAME=root
ARCADEDB_PASSWORD=playwithdata
# ArcadeDB Studio and HTTP API
ARCADEDB_HTTP_PORT=2490

# ----- Neo4j (stack compose.neo4j.yaml) -----

NEO4J_VERSION=2026.09.0
# the image's admin user: must be neo4j (the image only sets its password)
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
# Neo4j Browser
NEO4J_HTTP_PORT=7475
NEO4J_BOLT_PORT=7690

# ----- Elasticsearch (both stacks: Oak's elasticsearch indexes) -----

# Elasticsearch and Kibana: 8.19, the version of Oak 1.90's Elasticsearch client (Oak 2.x has the 9.x client)
ELASTICSEARCH_VERSION=8.19.23
# Elasticsearch HTTP API and Kibana (http://localhost:<port>), per stack
OAK_ARCADEDB_ELASTICSEARCH_PORT=9206
OAK_NEO4J_ELASTICSEARCH_PORT=9207
OAK_ARCADEDB_KIBANA_PORT=5607
OAK_NEO4J_KIBANA_PORT=5608
