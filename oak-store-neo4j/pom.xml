<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.integratedsemantics.oak.graph</groupId>
    <artifactId>oak-graph-store-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>oak-store-neo4j</artifactId>
  <name>Oak Store Neo4j</name>
  <description>Jackrabbit Oak DocumentStore storing the node documents in Neo4j or AuraDB (Neo4j Java driver)</description>

  <dependencies>
    <dependency>
      <groupId>org.integratedsemantics.oak.graph</groupId>
      <artifactId>oak-store-graph</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.jackrabbit</groupId>
      <artifactId>oak-store-document</artifactId>
    </dependency>
    <dependency>
      <!-- Neo4j Java driver (Apache 2.0) -->
      <groupId>org.neo4j.driver</groupId>
      <artifactId>neo4j-java-driver</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <!-- @NotNull / @Nullable of Oak's interfaces -->
      <groupId>org.jetbrains</groupId>
      <artifactId>annotations</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Test dependencies: the shared abstract tests, Oak's DocumentStore test suite and what it needs -->
    <dependency>
      <groupId>org.integratedsemantics.oak.graph</groupId>
      <artifactId>oak-store-graph</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.jackrabbit</groupId>
      <artifactId>oak-store-document</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.jackrabbit</groupId>
      <artifactId>oak-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.jackrabbit</groupId>
      <artifactId>oak-jcr</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.jackrabbit</groupId>
      <artifactId>oak-commons</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.jackrabbit</groupId>
      <artifactId>oak-store-spi</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- referenced by Oak's test fixtures (MongoDB, RDB) even when not used -->
      <groupId>org.mongodb</groupId>
      <artifactId>mongodb-driver-sync</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.1.214</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.tomcat</groupId>
      <artifactId>tomcat-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- tests start the Neo4j Docker image (unless an external server is configured) -->
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-neo4j</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- image tag of the Neo4j container: neo4j:${neo4j.version} (as the Docker Compose); another image:
                 -Doak.test.neo4j.image=<image> -->
            <oak.test.neo4j.version>${neo4j.version}</oak.test.neo4j.version>
            <!-- By default a Neo4j Docker container is started with Testcontainers (Docker needed). To test against an
                 external server (local Docker, standalone, or AuraDB with neo4j+s://), uncomment these lines or pass
                 them with -D. Only the nodes labeled OakTest* are touched (deleted after each test). -->
            <!-- <oak.test.neo4j.uri>bolt://localhost:7687</oak.test.neo4j.uri> -->
            <!-- <oak.test.neo4j.username>neo4j</oak.test.neo4j.username> -->
            <!-- <oak.test.neo4j.password>password</oak.test.neo4j.password> -->
            <!-- <oak.test.neo4j.database>neo4j</oak.test.neo4j.database> -->
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- mvn install -Pit: also runs the *IT stress tests -->
      <id>it</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <!-- image tag of the Neo4j container: neo4j:${neo4j.version} (as the Docker Compose); another image:
                     -Doak.test.neo4j.image=<image> -->
                <oak.test.neo4j.version>${neo4j.version}</oak.test.neo4j.version>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
